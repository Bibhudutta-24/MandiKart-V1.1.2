rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }

    // Farmers Collection
    match /farmers/{farmerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Buyers Collection
    match /buyers/{buyerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // FPOs Collection
    match /fpos/{fpoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasRole('FARMER') && request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && (
        (resource.data.farmerId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.farmerId == request.auth.uid && resource.data.status == 'DRAFT');
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.logisticsId == request.auth.uid ||
        isAdmin()
      );
      // Order creation & sensitive mutations handled through validated transaction or backend
      allow create: if isAuthenticated() && hasRole('BUYER');
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.buyerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']))
      );
      allow delete: if isAdmin();
    }

    // OrderItems Collection
    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated() && (
        resource.data.logisticsId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin() || (isAuthenticated() && hasRole('LOGISTICS'));
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      // Payment status updates only permitted by backend / admin
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
    }

    // Admin Actions Audit Log
    match /adminActions/{actionId} {
      allow read, write: if isAdmin();
    }
  }
}
